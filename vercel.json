{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/edit", "destination": "/edit.html" },
    { "source": "/instructor-auth", "destination": "/instructor-auth.html" },
    { "source": "/library", "destination": "/library.html" },
    { "source": "/portalaccess", "destination": "/portalaccess.html" },
    { "source": "/repository", "destination": "/repository.html" },
    { "source": "/student-auth", "destination": "/student-auth.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}