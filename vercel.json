{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html", "css/**", "js/**", "img/**"]
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api/server.js" },
    { "source": "/about", "destination": "api/server.js" },
    { "source": "/admin", "destination": "api/server.js" },
    { "source": "/edit", "destination": "api/server.js" },
    { "source": "/instructor-auth", "destination": "api/server.js" },
    { "source": "/library", "destination": "api/server.js" },
    { "source": "/portalaccess", "destination": "api/server.js" },
    { "source": "/repository", "destination": "api/server.js" },
    { "source": "/student-auth", "destination": "api/server.js" },
    { "source": "/team", "destination": "api/server.js" },
    { "source": "/upload", "destination": "api/server.js" },
    { "source": "/(.*)", "destination": "api/server.js" }
  ]
}